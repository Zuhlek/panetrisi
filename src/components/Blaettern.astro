---
import type { Kapitel } from '../lib/kapitel';

interface Props {
  vorher?: Kapitel;
  nachher?: Kapitel;
}

const { vorher, nachher } = Astro.props;
---

{(vorher || nachher) && (
  <nav class="blaettern" aria-label="Weitere Kapitel">
    {vorher && (
      <a href={vorher.ziel}><small>Zurück</small>{vorher.titel}</a>
    )}
    {nachher && (
      <a class="weiter" href={nachher.ziel}><small>Weiter</small>{nachher.titel}</a>
    )}
  </nav>
)}
