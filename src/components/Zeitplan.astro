---
interface Phase {
  name: string;
  minuten: number;
  anzeige?: string;
}

interface Props {
  daten: {
    titel: string;
    unterzeile?: string;
    legende?: string;
    phasen: Phase[];
  };
}

const { daten } = Astro.props;

const phasen = daten.phasen;
const gesamt = phasen.reduce((summe, p) => summe + p.minuten, 0);

/**
 * Die Farbe ergibt sich aus der Position in der Kette: früh hell, spät dunkel.
 * Sechs Stufen stehen zur Verfügung, weniger Phasen verteilen sich darauf.
 */
const stufe = (i: number) =>
  phasen.length < 2 ? 1 : Math.min(6, Math.max(1, Math.round(1 + (i * 5) / (phasen.length - 1))));

/** 45 → "45 Min.", 90 → "1,5 Std." */
function dauer(minuten: number) {
  if (minuten < 60) return `${minuten} Min.`;
  const stunden = Number((minuten / 60).toFixed(1));
  return `${String(stunden).replace('.', ',')} Std.`;
}
---

<figure class="viz">
  <p class="viz-titel">{daten.titel}</p>
  {daten.unterzeile && <p class="viz-unterzeile">{daten.unterzeile}</p>}

  <div class="zeitplan" style={`--gesamt: ${gesamt}`}>
    <div class="zp-spur">
      {phasen.map((p, i) => (
        <span
          class="zp-phase"
          data-stufe={stufe(i)}
          style={`--dauer: ${p.minuten}`}
          title={`${p.name} · ${p.anzeige ?? dauer(p.minuten)}`}
        ></span>
      ))}
    </div>

    <ol class="zp-legende">
      {phasen.map((p, i) => (
        <li>
          <span class="zp-punkt" data-stufe={stufe(i)} aria-hidden="true"></span>
          <div>
            <b>{p.name}</b>
            <span>{p.anzeige ?? dauer(p.minuten)}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>

  {daten.legende && <figcaption>{daten.legende}</figcaption>}
</figure>
