---
import type { MarkdownHeading } from 'astro';

interface Props {
  ueberschriften: MarkdownHeading[];
}

const { ueberschriften } = Astro.props;

// Nur die zweite Ebene — die dritte würde das Verzeichnis überladen.
const eintraege = ueberschriften.filter((u) => u.depth === 2);
---

{eintraege.length > 1 && (
  <nav class="inhalt" aria-label="Inhalt dieser Seite">
    <h2>Auf dieser Seite</h2>
    <ol>
      {eintraege.map((u) => (
        <li><a href={`#${u.slug}`}>{u.text}</a></li>
      ))}
    </ol>
  </nav>
)}
