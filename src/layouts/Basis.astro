---
import '../styles/site.css';
import Dateibaum from '../components/Dateibaum.astro';
import { dateibaum } from '../lib/baum';
import { pfad } from '../lib/pfad';

interface Props {
  titel: string;
  beschreibung?: string;
  /** Sammlungs-ID der aktuellen Seite, für die Hervorhebung im Baum. */
  aktiv?: string;
  nichtIndexieren?: boolean;
}

const { titel, beschreibung, aktiv, nichtIndexieren = false } = Astro.props;
const baum = await dateibaum();
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titel} — panetrisi</title>
  {beschreibung && <meta name="description" content={beschreibung} />}
  {nichtIndexieren && <meta name="robots" content="noindex" />}
  <link rel="icon" href={pfad('favicon.svg')} type="image/svg+xml" />
</head>

<body>
  <a class="zum-inhalt" href="#inhalt">Zum Inhalt springen</a>

  <div class="rahmen">
    <aside class="leiste">
      <a class="wortmarke" href={pfad()}>pane<em>trisi</em></a>
      <nav class="baum" aria-label="Alle Seiten">
        <Dateibaum knoten={baum} aktiv={aktiv} />
      </nav>
    </aside>

    <main id="inhalt">
      <article class="fliesstext">
        <slot />
      </article>
    </main>
  </div>
</body>
</html>
