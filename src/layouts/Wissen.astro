---
import type { MarkdownHeading } from 'astro';
import Basis from './Basis.astro';
import Verzeichnis from '../components/Verzeichnis.astro';
import Blaettern from '../components/Blaettern.astro';
import type { Kapitel } from '../lib/kapitel';

interface Props {
  daten: {
    titel: string;
    kicker?: string;
    lead: string;
    beschreibung?: string;
    verzeichnis: boolean;
  };
  aktiv: string;
  ueberschriften: MarkdownHeading[];
  vorher?: Kapitel;
  nachher?: Kapitel;
}

const { daten, aktiv, ueberschriften, vorher, nachher } = Astro.props;
---

<Basis titel={daten.titel} beschreibung={daten.beschreibung ?? daten.lead} aktiv={aktiv}>
  <div class="spalte">
    <div class="seitenkopf">
      {daten.kicker && <span class="kicker">{daten.kicker}</span>}
      <h1>{daten.titel}</h1>
      <p class="lead">{daten.lead}</p>
    </div>

    {daten.verzeichnis && <Verzeichnis ueberschriften={ueberschriften} />}

    <div class="fliesstext">
      <slot />
    </div>

    <Blaettern vorher={vorher} nachher={nachher} />
  </div>
</Basis>
