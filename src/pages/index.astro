---
import Basis from '../layouts/Basis.astro';
import Karte from '../components/Karte.astro';
import Zeitplan from '../components/Zeitplan.astro';
import { pfad } from '../lib/pfad';
import { wissenseiten, rezeptseiten } from '../lib/kapitel';

const wissen = await wissenseiten();
const rezepte = await rezeptseiten();

// Grober Ablauf, der für fast jedes Sauerteigbrot gilt — als Vorgeschmack.
const ablauf = {
  titel: 'Typischer Ablauf eines Sauerteigbrotes',
  unterzeile: 'Anteil an der Gesamtdauer von rund 16 Stunden',
  legende: 'Aktive Arbeitszeit sind rund 45 Minuten. Der Rest ist Warten — und genau daraus entsteht der Geschmack.',
  phasen: [
    { name: 'Autolyse', minuten: 60 },
    { name: 'Kneten', minuten: 20 },
    { name: 'Stockgare', minuten: 180 },
    { name: 'Kaltgare', minuten: 600 },
    { name: 'Formen & Stückgare', minuten: 90 },
    { name: 'Backen', minuten: 35 },
  ],
};
---

<Basis
  titel="Brot backen"
  beschreibung="Sauerteig, Grundlagen und Rezepte zum Brotbacken."
  aktiv="start"
>
  <div class="spalte-breit">

    <div class="seitenkopf">
      <h1>Brot braucht vor allem Zeit.</h1>
      <p class="lead">
        Eine Sammlung von Rezepten und Notizen zum Backen mit Sauerteig — von der
        ersten Fütterung bis zum Baguette aus dem eigenen Ofen.
      </p>
    </div>

    <ul class="raster">
      {wissen.map((e) => (
        <Karte
          ziel={pfad(`wissen/${e.id}`)}
          titel={e.data.titel}
          text={e.data.kartentext ?? e.data.lead}
          meta={e.data.kartenmeta}
          bild={e.data.bild}
          bildAlt={e.data.bildAlt}
        />
      ))}
      {rezepte.map((e) => (
        <Karte
          ziel={pfad(`rezepte/${e.id}`)}
          titel={e.data.titel}
          text={e.data.kartentext ?? e.data.lead}
          meta={e.data.kartenmeta}
          bild={e.data.bild}
          bildAlt={e.data.bildAlt}
        />
      ))}
    </ul>

    <section class="abschnitt">
      <h2>Der Ablauf</h2>
      <p class="gedaempft">
        Fast jedes Brot folgt demselben Muster. Was sich unterscheidet, sind die Mehle,
        die Wassermenge und wie lange man wartet — und gewartet wird fast die ganze Zeit.
      </p>
      <Zeitplan daten={ablauf} />
    </section>

  </div>
</Basis>
