---
import Basis from '../layouts/Basis.astro';
import { pfad } from '../lib/pfad';
---

<Basis titel="Nicht gefunden" nichtIndexieren>
  <div class="spalte">
    <div class="seitenkopf">
      <h1>Übergare.</h1>
      <p class="lead">
        Diese Seite gibt es nicht — oder nicht mehr. Vielleicht war der Link zu lange
        im Kühlschrank.
      </p>
      <p><a href={pfad()}>Zurück zur Startseite</a></p>
    </div>
  </div>
</Basis>
