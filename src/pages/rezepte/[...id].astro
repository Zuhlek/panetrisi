---
import { render } from 'astro:content';
import Rezept from '../../layouts/Rezept.astro';
import { rezeptseiten, kapitelkette, nachbarn } from '../../lib/kapitel';

export async function getStaticPaths() {
  const seiten = await rezeptseiten();
  return seiten.map((eintrag) => ({
    params: { id: eintrag.id },
    props: { eintrag },
  }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);

const kette = await kapitelkette();
const { vorher, nachher } = nachbarn(kette, 'rezepte', eintrag.id);
---

<Rezept daten={eintrag.data} vorher={vorher} nachher={nachher}>
  <Content />
</Rezept>
